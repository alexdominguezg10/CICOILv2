# === CICOILv2 .gitignore ===

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Personal run scripts (site-specific paths)
run_nohoch*.py
run_abkatun*.py
run_ensemble_uq.py

# Calibration / sweep scripts
recalibrate_*.py
sweep_*.py

# Personal plot / analysis scripts
plot_*.py
compare_*.py
estimate_*.py
make_*.py

# Test outputs (generated by test suite)
*.nc
test_cicoil_budget.png
figures/*.png

# Session logs (Claude Code artifacts)
session_*.html
session_*.tex
session_*.pdf

# Findings / report docs (session-specific)
findings_*.md
report_*.html

# LaTeX / PDF build artifacts
*.pdf
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Local data directories
data_local/
data_local

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*~

# Temporary
tmp_claude/
temp/
